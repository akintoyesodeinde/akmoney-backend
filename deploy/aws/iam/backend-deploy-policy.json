{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBackendDockerHubCredentialsRetrieval",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:eu-north-1:415805875879:parameter/akmoney/ci/backend/dockerhub-username",
        "arn:aws:ssm:eu-north-1:415805875879:parameter/akmoney/ci/backend/dockerhub-token"
      ]
    },
    {
      "Sid": "AllowKMSDecryptForBackendCIParameters",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "ssm.eu-north-1.amazonaws.com",
            "ssm.us-east-1.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowApprovedBackendSSMDocumentsOnTaggedEC2",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ssm:eu-north-1:415805875879:document/AkMoney-Deploy-Backend",
        "arn:aws:ssm:eu-north-1:415805875879:document/AkMoney-Rollback-Backend"
      ]
    },
    {
      "Sid": "AllowSSMCommandOnTaggedAkMoneyInstance",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ec2:eu-north-1:415805875879:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "AkMoney",
          "aws:ResourceTag/Environment": "Production"
        }
      }
    },
    {
      "Sid": "AllowSSMCommandStatusTracking",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:ListCommands"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowEC2InstanceDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus"
      ],
      "Resource": "*"
    }
  ]
}
