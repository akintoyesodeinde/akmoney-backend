{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsFrontendOIDCTrust",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::415805875879:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:akintoyesodeinde/akmoney-frontend:ref:refs/heads/main"
        }
      }
    }
  ]
}
