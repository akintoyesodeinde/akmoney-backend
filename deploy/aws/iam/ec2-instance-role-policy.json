{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowRuntimeSSMParametersRead",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:*:415805875879:parameter/akmoney/prod/backend/*",
        "arn:aws:ssm:*:415805875879:parameter/akmoney/prod/registry/*"
      ]
    },
    {
      "Sid": "AllowKMSDecryptForRuntimeParameters",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowCloudWatchLogsForAkMoney",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:PutRetentionPolicy"
      ],
      "Resource": "arn:aws:logs:*:415805875879:log-group:/akmoney/*"
    }
  ]
}
